{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "yorigo-f7408",
          "appId": "1:784944328733:android:c723cfd6b97df9d58c96f4",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "yorigo-f7408",
          "appId": "1:784944328733:ios:928c3721ba6ef5118c96f4",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "yorigo-f7408",
          "configurations": {
            "android": "1:784944328733:android:c723cfd6b97df9d58c96f4",
            "ios": "1:784944328733:ios:928c3721ba6ef5118c96f4"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "account-deletion.html",
        "destination": "/account-deletion.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
