rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Reviews photos: users can upload to their own directory
    match /reviews/{userId}/{reviewId} {
      // Allow read for anyone (so reviews can be displayed)
      allow read: if true;
      
      // Allow write only if:
      // 1. User is authenticated
      // 2. The userId in the path matches the authenticated user's ID
      // 3. File size is less than 10MB (to prevent abuse)
      allow write: if request.auth != null &&
                     request.auth.uid == userId &&
                     request.resource.size < 10 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
      
      // Allow delete only by the owner
      allow delete: if request.auth != null &&
                      request.auth.uid == userId;
    }
    
    // Profile images: users can upload/delete their own profile picture
    match /profile_images/{fileName} {
      // Allow read for anyone (so profile pictures can be displayed)
      allow read: if true;
      
      // Allow write only if:
      // 1. User is authenticated
      // 2. The fileName matches the authenticated user's ID (with .jpg extension)
      // 3. File size is less than 5MB (profile pictures should be smaller)
      // 4. File is an image
      allow write: if request.auth != null &&
                     fileName == request.auth.uid + '.jpg' &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
      
      // Allow delete only by the owner
      allow delete: if request.auth != null &&
                      fileName == request.auth.uid + '.jpg';
    }
    
    // Resize extension outputs here (e.g. .../thumbnails/{id}_200x200.jpg).
    // Must be explicit: /recipe_thumbnails/{fileName} only matches one segment under recipe_thumbnails.
    match /recipe_thumbnails/thumbnails/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }

    // Recipe thumbnails: anyone can read, authenticated users can upload
    match /recipe_thumbnails/{fileName} {
      // Allow read for anyone (so thumbnails can be displayed)
      allow read: if true;
      
      // Allow write only if:
      // 1. User is authenticated
      // 2. File size is less than 5MB
      // 3. File is an image
      allow write: if request.auth != null &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
      
      // Client-side delete blocked to prevent arbitrary cross-user deletions.
      allow delete: if false;
    }
    
    // Todo images: authenticated users can upload/delete images for todos
    match /todos/{fileName} {
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Allow write only if:
      // 1. User is authenticated
      // 2. File size is less than 10MB (screenshots can be larger)
      // 3. File is an image
      allow write: if request.auth != null &&
                     request.resource.size < 10 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
      
      // Client-side delete blocked to prevent arbitrary cross-user deletions.
      allow delete: if false;
    }
    
    // Behavioral signal batches (impression/click/cook_done/purchase/review 등).
    // 클라이언트가 이벤트를 버퍼링했다가 세션 단위로 JSONL 파일 하나씩 업로드한다.
    // 경로: signals/raw/{yyyy-MM-dd}/{uid}/{sessionId}_{ts}_{batchId}.jsonl
    match /signals/raw/{date}/{userId}/{fileName} {
      // 읽기는 클라이언트에서 허용하지 않음 — 백엔드 일일 스케줄러가 서비스 계정으로만 접근.
      allow read: if false;
      allow write: if request.auth != null &&
                     request.auth.uid == userId &&
                     request.resource.size < 1 * 1024 * 1024 &&
                     fileName.matches('.*[.]jsonl$');
      allow delete: if false;
    }

    // 홈 CMS 포스터 이미지. 앱 표시용 공개 읽기, 쓰기는 Admin SDK 만.
    match /home_cms/posters/{posterId}/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }

    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

